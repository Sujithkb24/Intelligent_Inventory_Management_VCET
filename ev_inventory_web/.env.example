# In dev the Vite proxy forwards /api to http://localhost:8000.
# Use the full URL (http://localhost:8000/api/v1) only if the backend enables CORS
# for this origin and allows the X-User and X-Role headers.
VITE_API_BASE_URL=/api/v1
VITE_POLL_RISK_MS=30000
VITE_POLL_ALERTS_MS=15000
VITE_POLL_HEALTH_MS=10000
VITE_CURRENCY=$
VITE_RISK_BUFFER_LABEL=Slack buffer (days)
